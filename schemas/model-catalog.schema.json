{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered worker model catalog",
  "type": "object",
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "context_window", "auto_review_model_override"]
      }
    }
  }
}
