{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered worker model catalog package invariants",
  "type": "object",
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug", "auto_review_model_override", "apply_patch_tool_type",
          "model_messages", "supports_search_tool", "base_instructions"
        ],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "model_messages": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instructions_template"],
            "properties": {
              "instructions_template": {"type": "string", "minLength": 1}
            }
          },
          "apply_patch_tool_type": {"const": "freeform"},
          "supports_search_tool": {"const": false},
          "auto_review_model_override": {"type": "string", "minLength": 1},
          "base_instructions": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
